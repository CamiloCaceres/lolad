<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.caceres.lolad</string>
  <key>BundleProgram</key><string>Contents/Helpers/lolad</string>
  <key>ProgramArguments</key>
  <array><string>lolad</string><string>serve</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>ProcessType</key><string>Interactive</string>
  <key>EnvironmentVariables</key>
  <dict><key>LOLAD_INSTALL</key><string>app</string></dict>
  <!-- No StandardOutPath/StandardErrorPath: launchd does not expand "~", and a
       path it cannot open makes the job fail with EX_CONFIG (78) before the
       daemon starts (spike S5, docs/desktop.md). With stdout on /dev/null,
       `lolad serve` writes its own rotated <state>/logs/daemon.log. -->
</dict>
</plist>
