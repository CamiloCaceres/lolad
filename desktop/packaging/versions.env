# Pinned third-party versions for every package. Sourced by the build scripts
# and the release workflow. Bump a version together with its checksum.

# tmux (macOS, built from source by macos/build-tmux.sh) and its libevent
TMUX_VERSION=3.5a
TMUX_SHA256=16216bd0877170dfcc64157085ba9013610b12b082548c7c9542cc0103198951
LIBEVENT_VERSION=2.1.12-stable
LIBEVENT_SHA256=92e6de1be9ec176428fd2367677e61ceffc2ee1cb119035037a27d346b0403bb

# psmux (Windows, MIT, https://github.com/psmux/psmux), x64 release zip
PSMUX_VERSION=3.4.0
PSMUX_SHA256=a66b6be7c13c6fa0dc3660a267b9e34eaa91a4eb7f07fbd55a0468018bd0f721

# lolabot (MIT, https://github.com/23blocks-OS/lolabot): the tag CI bundles
LOLABOT_REPO=https://github.com/23blocks-OS/lolabot
LOLABOT_TAG=v1.3.1

# multiplexer.version, identical on both platforms. The updater compares this
# string with update.json's multiplexer_version; when it differs, agents restart
# during the update. Any change to tmux or psmux changes it.
MULTIPLEXER_VERSION="tmux-${TMUX_VERSION}_psmux-${PSMUX_VERSION}"
